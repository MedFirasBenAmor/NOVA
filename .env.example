# API
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
DATABASE_URL=postgresql://nova:nova@localhost:5433/nova?schema=public

# Intelligence: mock works offline. Gemini is optional for development.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Private document boundary (local development only)
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=./var/documents
MAX_DOCUMENT_UPLOAD_BYTES=10485760
REDIS_HOST=localhost
REDIS_PORT=6379
OCR_PROVIDER=mock
PADDLE_OCR_URL=http://127.0.0.1:8001/ocr
ANONYMOUS_SESSION_TTL_SECONDS=86400
ANONYMOUS_SESSION_COOKIE_NAME=nova_session
